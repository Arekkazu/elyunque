# Copiar al VPS como ~/elyunque/.env y completar con valores reales
IMAGE_PREFIX=ghcr.io/arekkazu/elyunque
POSTGRES_USER=elyunque
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=elyunque
JWT_SECRET=genere-un-secreto-largo-con-openssl-rand-hex-32
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://IP_O_DOMINIO_DEL_VPS
# true solo la primera vez para crear usuarios demo; luego false
SEED_ON_START=false
